{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (root.child('users/'+auth.uid).exists() && root.child('users/'+auth.uid).child('role').val() == 'lider' && root.child('users/'+auth.uid).child('organizacion').val() == data.child('organizacion').val()))",
        ".write": "auth != null && (auth.uid == $uid || (root.child('users/'+auth.uid).exists() && root.child('users/'+auth.uid).child('role').val() == 'lider' && root.child('users/'+auth.uid).child('organizacion').val() == data.child('organizacion').val()))"
      }
    },
    "conversations": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (root.child('users/'+auth.uid).exists() && root.child('users/'+auth.uid).child('role').val() == 'lider' && root.child('users/'+auth.uid).child('organizacion').val() == root.child('users/'+$uid).child('organizacion').val()))",
        ".write": "auth != null && (auth.uid == $uid || (root.child('users/'+auth.uid).exists() && root.child('users/'+auth.uid).child('role').val() == 'lider' && root.child('users/'+auth.uid).child('organizacion').val() == root.child('users/'+$uid).child('organizacion').val()))"
      }
    }
  }
}
